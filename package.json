{
  "name": "roseboard",
  "version": "1.5.2",
  "private": true,
  "description": "A local-first task canvas for Obsidian",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node scripts/schema.mjs && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/fixtures.ts",
    "test:obsidian": "node scripts/test-obsidian.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src tests scripts esbuild.config.mjs",
    "test:vault": "node scripts/launch-test-vault.mjs",
    "test:planner": "node scripts/test-planner-obsidian.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "immer": "10.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "playwright": "1.63.0",
    "postcss": "^8.5.6",
    "postcss-prefix-selector": "^2.1.1",
    "prettier": "3.9.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.1"
  }
}
